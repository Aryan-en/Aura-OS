[Unit]
Description=AURA OS HUD web server (loopback only)
After=aura-core.service
Wants=aura-core.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=HOME=@HOME@
Environment=XDG_RUNTIME_DIR=/run/aura
ExecStart=@ROOT@/.venv/bin/python -m aura.ui.server
RuntimeDirectory=aura
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
