[Unit]
Description=AURA OS core daemon (voice, agents, memory)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
SupplementaryGroups=audio video input render
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=HOME=@HOME@
Environment=XDG_RUNTIME_DIR=/run/aura
ExecStart=@ROOT@/.venv/bin/python -m aura.core.main
RuntimeDirectory=aura
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=3
Nice=-5
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
